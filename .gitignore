node_modules/
dist/
packages/

# Written by external tooling (e.g. an Adobe design skill) into the repo root
# rather than a scratch directory -- not a build artifact of this project, and
# not meant to be committed. One such file was swept in by `git add -A` once;
# this stops it recurring rather than relying on remembering to check.
output/

.pnpm-store/
pnpm-lock.yaml
pnpm-workspace.yaml

*.log
.DS_Store
Thumbs.db

.env
.env.*

# Draft shooting script for a promo video -- not part of the product.
docs/video-01-intro-shooting-script.md

# Raw screen captures behind the README's screenshots, ~12 MB of them. The .webp
# files beside them are cropped and encoded from these and ARE committed -- the
# README displays seven of them, so this rule is deliberately narrowed to .png
# rather than excluding the directory. Ignoring the whole folder would leave
# every image in the README broken on github.com.
docs/assets/v0200/*.png

# Assistant tooling, not project configuration. launch.json describes how to
# start dev servers for a Claude Code session and settings.local.json holds
# per-machine permissions; nothing in npm, the plugin, UXP, or CI reads either.
#
# Written as `.claude/*` rather than `.claude/` on purpose: git will not descend
# into an excluded directory, so a negation below can only re-include something
# if the directory itself was never excluded.
.claude/*

# Agent definitions are the exception. They encode project knowledge -- the
# 12 GB hardware ceiling, the preset registry contract, what a workflow costs to
# adopt -- that belongs to the repo rather than to one machine, and that anyone
# continuing this project should get automatically.
!.claude/agents/
