      "path": "icons/openlayer-96.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "light",
        "lightest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 144,
      "height": 144,
      "path": "icons/openlayer-144.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
