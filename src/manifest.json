{
  "manifestVersion": 5,
  "id": "com.openlayer.photoshop",
  "name": "OpenLayer",
  "version": "0.15.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "clipboard": "readAndWrite",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "openlayer.panel",
      "label": {
        "default": "OpenLayer"
      },
      "minimumSize": {
        "width": 320,
        "height": 480
      },
      "maximumSize": {
        "width": 720,
        "height": 1200
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 760
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "all"
          ],
          "species": [
            "generic",
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_N.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic",
            "chrome"
          ]
        }
      ]
    },
    {
      "type": "panel",
      "id": "openlayerPreview",
      "label": {
        "default": "OpenLayer Preview"
      },
      "minimumSize": {
        "width": 220,
        "height": 220
      },
      "maximumSize": {
        "width": 3000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 520,
        "height": 520
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_D.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium",
            "all"
          ],
          "species": [
            "generic",
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon_N.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "generic",
            "chrome"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon_D.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "dark",
        "darkest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/icon_N.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/openlayer-48.png",
      "scale": [
        1
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "light",
        "lightest"
      ],
      "species": [
        "generic"
      ]
    },
    {
      "width": 96,
